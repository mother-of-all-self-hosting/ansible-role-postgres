{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "labels": [
    "dependencies"
  ],
  "separateMajorMinor": true,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "commitBody": "[skip ci]",
      "schedule": ["* * 1-7 */6 *"],
      "automergeSchedule": ["* * 1-14 */6 *"],
      "groupName": "GitHub Actions dependencies"
    },
    {
      "matchManagers": ["mise", "pip_requirements", "pre-commit", "pyenv"],
      "schedule": ["* * 1-7 */6 *"],
      "automergeSchedule": ["* * 1-14 */6 *"]
    },
    {
      "matchPackageNames": ["/postgres/"],
      "matchUpdateTypes": ["major", "patch"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/defaults/main.yml$/"
      ],
      "matchStrings": [
        "(?<name>postgres_container_image_v\\d+_version):\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "pyenv": {
    "enabled": true
  }
}
